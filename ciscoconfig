
ROUTER********Cisco ISR 4331
en
conf t
hostname STUDENT-ROUTER
no ip domain-lookup
ip dhcp snooping
spanning-tree portfast default
spanning-tree portfast bpduguard default
ip arp inspection validate src-mac dst-mac ip
enable secret STUDENT
service password-encryption
banner motd #Authorized Access Only!#

line vty 0 15
password STUDENT
login
logging synchronous
exit

line con 0
password STUDENT
login
logging synchronous
exit

interface g0/0/0.10
description Default Gateway for VLAN 10 Home
encap dot1q 10
ip address 192.168.100.1 255.255.255.128
no shutdown
exit
interface g0/0/0.20
description Default Gateway for VLAN 20 Wireless
encap dot1q 20
ip address 192.168.100.129 255.255.255.224
no shutdown
exit
interface g0/0/0.30
Description Default Gateway for VLAN 30 native
encap dot1q 30 native
ip address 192.168.100.161 255.255.255.252
no shutdown
exit
interface g0/0/0
no shutdown
exit

ip dhcp excluded-address 192.168.100.1 192.168.100.5
ip dhcp excluded-address 192.168.100.129 192.168.100.133

ip dhcp pool Home
network 192.168.100.0 255.255.255.128
default-router 192.168.100.1
dns-server 8.8.8.8
exit

ip dhcp pool Wireless
network 192.168.100.128 255.255.255.224
default-router 192.168.100.129
dns-server 8.8.8.8


SWITCH******** 2960-24TT
en
conf t
hostname STUDENT-SWITCH
no ip domain-lookup
enable secret STUDENT
service password-encryption
banner motd #Authorized Access Only!#

line vty 0 15
password STUDENT
login
logging synchronous
exit

line con 0
password STUDENT
login
logging synchronous
exit

interface vlan 30
Description Native VLAN 30
ip address 192.168.100.160 255.255.255.252
no shutdown
exit
interface g0/1
switchport mode trunk
switchport trunk native vlan 30
exit
interface f0/1
switchport mode access
switchport access vlan 10
exit
interface f0/2
switchport mode access
switchport access vlan 20
exit

interface range f0/3 - 22
shutdown
interface range f0/23-24
switchport mode trunk
shutdown
channel-group 1 mode active
no shutdown
exit
interface port-channel 1
switchport mode trunk


